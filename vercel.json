{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/presentations/:id",
      "destination": "/presentations/pdf/:id.pdf",
      "permanent": false
    },
    {
      "source": "/newsletters/:id",
      "destination": "/newsletters/pdf/:id.pdf",
      "permanent": false
    },
    {
      "source": "/founder-report/:id",
      "destination": "/founder-reports/pdf/:id.pdf",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/:library(presentations|newsletters|founder-reports)/pdf/:file*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    },
    {
      "source": "/:library(presentations|newsletters|founder-reports)/originals/:file*",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    }
  ]
}
